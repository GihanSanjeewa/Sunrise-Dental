# Sunrise Dental Clinic Environment Configuration Example
# Copy this file to .env and configure local credentials. Never commit real passwords.

SERVER_PORT=8080

# Database Configuration (MySQL 8.x / XAMPP)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sunrise_dental_db
DB_USERNAME=root
DB_PASSWORD=

# JPA / Hibernate Configuration
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true

